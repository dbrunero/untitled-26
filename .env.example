# Copy to .env (never commit real values).

# Public URL of the production site, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph and the allowed host of the on-demand API route.
PUBLIC_SITE_URL=https://www.example.com

# ── Contact form (Resend) ──────────────────────────────────────────
# Server-side only. Without these the form answers with a clear error in production
# (it only "pretends" to send in `pnpm dev`).
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
RESEND_API_KEY=
# Optional: override the provider API base URL (tests use a local mock).
# RESEND_API_URL=https://api.resend.com

# ── Optional third parties (loaded ONLY after the matching cookie consent) ──
# Leave empty to disable. Public by nature (they end up in the browser bundle).
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
