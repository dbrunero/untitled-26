# Copy to .env (never commit real values). All values are read at BUILD time.

# Public URL of the production site, no trailing slash (canonical URLs, sitemap, Open Graph).
PUBLIC_SITE_URL=https://www.example.com

# Contact form: Formspree form ID (the last part of https://formspree.io/f/XXXXXXXX).
# Without it the form shows a clear error in production (it only simulates sending in `pnpm dev`).
PUBLIC_FORMSPREE_ID=

# Optional third parties (loaded ONLY after the matching cookie consent). Leave empty to disable.
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_META_PIXEL_ID=
