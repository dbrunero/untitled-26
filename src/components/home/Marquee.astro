---
interface Props {
  words?: string[];
  direction?: 'forward' | 'reverse';
}
const { words = ['Foto', 'Video', 'Social', 'Ads', 'SEO', 'Web', 'Ecommerce', 'CRM', 'Web app'], direction = 'forward' } = Astro.props;
---

<!-- Decorative: the same words appear in the Services section. Moves with scroll, never loops by itself. -->
<div class="marquee" data-marquee={direction === 'reverse' ? 'reverse' : 'forward'} aria-hidden="true">
  <div class="marquee__track" data-marquee-track>
    {
      [0, 1, 2].map(() => (
        <span class="marquee__group">
          {words.map((w, i) => (
            <span class:list={['marquee__word', i % 2 === 1 && 'is-filled']}>
              {w}
              <span class="marquee__sep">✺</span>
            </span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    padding-block: var(--space-5);
    border-block: 1px solid var(--color-line);
    background: var(--color-bg);
    user-select: none;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__group {
    display: inline-flex;
    flex: none;
  }
  .marquee__word {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-right: clamp(1.5rem, 4vw, 4rem);
    font-size: clamp(2.5rem, 1rem + 6vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-text);
    white-space: nowrap;
  }
  .marquee__word.is-filled {
    color: var(--color-text);
    -webkit-text-stroke: 0;
  }
  .marquee__sep {
    font-size: 0.4em;
    color: var(--color-accent);
    -webkit-text-stroke: 0;
  }
</style>
