---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
// Asymmetric rhythm: wide, then portrait + landscape pairs, repeating.
const rhythm = ['wide', 'portrait', 'landscape', 'landscape', 'portrait', 'wide'] as const;
---

<div class="pg" data-work-grid>
  {
    projects.map((p, i) => {
      const variant = rhythm[i % rhythm.length] ?? 'landscape';
      return <ProjectCard project={p} index={i} variant={variant} filterable priority={i === 0} class={`pg__item pg__item--${i % rhythm.length}`} />;
    })
  }
</div>

<style>
  .pg {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8) var(--gutter);
    align-items: start;
  }
  .pg :global(.pg__item) {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .pg {
      row-gap: var(--space-9);
    }
    .pg :global(.pg__item--1) {
      grid-column: 1 / span 5;
    }
    .pg :global(.pg__item--2) {
      grid-column: 6 / span 7;
      margin-top: var(--space-9);
    }
    .pg :global(.pg__item--3) {
      grid-column: 1 / span 7;
    }
    .pg :global(.pg__item--4) {
      grid-column: 8 / span 5;
      margin-top: var(--space-9);
    }
  }
</style>
