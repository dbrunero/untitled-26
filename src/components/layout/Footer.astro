---
import { site, nav, mailto, tel, safeUrl, isPlaceholder } from '../../config/site';
import Button from '../ui/Button.astro';

const email = mailto();
const phone = tel();
const instagram = safeUrl(site.instagram);
const linkedin = safeUrl(site.linkedin);
const callHref = site.calendarUrl ? site.calendarUrl : '/contact#call';
const year = new Date().getFullYear();
---

<footer class="footer" data-site-footer data-footer-reveal data-theme="dark" data-hide-sticky>
  <div class="container">
    <div class="footer__top">
      <p class="label label--muted"><span class="label__dot"></span>Contatti</p>
      <h2 class="footer__headline display" data-footer-headline>
        <span class="line"><span>FACCIAMOLO</span></span>
        <span class="line"><span>VALERE LA PENA.</span></span>
        <span class="footer__serif serif accent">guardare e usare.</span>
      </h2>
      <div class="footer__cta">
        <Button href={callHref} size="large" {...(site.calendarUrl ? { target: '_blank', rel: 'noopener' } : {})}>Prenota una call</Button>
        <Button href="/contact" variant="ghost" size="large">Richiedi un preventivo</Button>
      </div>
    </div>

    <div class="footer__grid">
      <div class="footer__col">
        <h3 class="label label--muted">Scrivici</h3>
        <ul>
          <li>{email ? <a href={email} class="footer__big">{site.email}</a> : <span class="footer__big ph">{site.email}</span>}</li>
          <li>{phone ? <a href={phone}>{site.phone}</a> : <span class="ph">{site.phone}</span>}</li>
          <li><span class="ph">{site.city}</span></li>
        </ul>
      </div>
      <div class="footer__col">
        <h3 class="label label--muted">Seguici</h3>
        <ul>
          <li>
            {instagram ? <a href={instagram} rel="noopener noreferrer" target="_blank">Instagram<span class="sr-only"> (si apre in una nuova scheda)</span></a> : <span class="ph">Instagram {site.instagram}</span>}
          </li>
          <li>
            {linkedin ? <a href={linkedin} rel="noopener noreferrer" target="_blank">LinkedIn<span class="sr-only"> (si apre in una nuova scheda)</span></a> : <span class="ph">LinkedIn {site.linkedin}</span>}
          </li>
        </ul>
      </div>
      <div class="footer__col">
        <h3 class="label label--muted">Studio</h3>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <h3 class="label label--muted">Legale</h3>
        <ul>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/cookie-policy">Cookie Policy</a></li>
          <li><button type="button" class="footer__linkbtn" data-consent-open>Gestisci preferenze cookie</button></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__legal">
        © {year} {site.name}. {site.legalName} — P.IVA {site.vat} — {site.address}, {site.city}
        {!isPlaceholder(site.pec) && <span> — PEC {site.pec}</span>}
        {isPlaceholder(site.pec) && <span> — PEC <span class="ph">{site.pec}</span></span>}
      </p>
      <a class="footer__top-link" href="#top" data-back-to-top>
        <span>Torna su</span>
        <span class="footer__top-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16"><path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    overflow: clip;
    background: var(--color-bg);
    color: var(--color-text);
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-section);
  }
  .footer__top {
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
  .footer__headline {
    font-size: var(--fs-mega);
    line-height: 0.84;
    will-change: transform;
  }
  .footer__serif {
    display: block;
    font-size: 1.05em;
    line-height: 1;
    margin-top: 0.12em;
    text-transform: none;
  }
  .footer__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-6) var(--gutter);
    grid-template-columns: 1fr;
    margin-top: var(--space-9);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    }
  }
  .footer__col ul {
    display: grid;
    gap: 0.15rem;
    margin-top: var(--space-3);
  }
  .footer__col a,
  .footer__linkbtn {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 calc(100% - 0.5rem);
    transition: background-size 0.4s var(--ease-out), color 0.2s;
    text-align: left;
  }
  .footer__col a:hover,
  .footer__linkbtn:hover,
  .footer__col a:focus-visible {
    background-size: 100% 1px;
    color: var(--color-accent);
  }
  .footer__big {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .ph {
    color: var(--color-muted);
    border-bottom: 1px dashed var(--color-line);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-line);
    font-size: var(--fs-small);
    color: var(--color-muted);
  }
  .footer__legal {
    max-width: 62ch;
  }
  .footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    color: var(--color-text);
    font-weight: 600;
  }
  .footer__top-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    transition: background-color 0.3s, color 0.3s, transform 0.5s var(--ease-out);
  }
  .footer__top-link:hover .footer__top-icon,
  .footer__top-link:focus-visible .footer__top-icon {
    background: var(--color-accent);
    color: var(--color-accent-ink);
    transform: translate3d(0, -4px, 0);
  }
</style>
