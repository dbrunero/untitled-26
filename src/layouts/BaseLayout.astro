---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/animations.css';
import '../styles/buttons.css';
import grotesk from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import { site } from '../config/site';
import SEO from '../components/layout/SEO.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import StickyCta from '../components/layout/StickyCta.astro';
import CustomCursor from '../components/ui/CustomCursor.astro';
import CookieBanner from '../components/consent/CookieBanner';
import type { Crumb } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  isHome?: boolean;
  breadcrumbs?: Crumb[];
  jsonLd?: Array<Record<string, unknown>>;
  /** Hides the sticky mobile CTA (e.g. pages that already are a form). */
  noStickyCta?: boolean;
}

const { noStickyCta = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="dark light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />

    <!-- Pre-paint flags: JS available + motion allowed. Re-applied after view transitions by core/lifecycle.ts -->
    <script is:inline>
      (function () {
        const r = document.documentElement;
        r.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) r.classList.add('motion');
      })();
    </script>

    <SEO {...seo} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={grotesk} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Vai al contenuto</a>
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <Header />
    <MobileMenu />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!noStickyCta && <StickyCta />}
    <CustomCursor />
    <CookieBanner client:load transition:persist />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style is:global>
  .scroll-progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: calc(var(--z-header) + 1);
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }
</style>
